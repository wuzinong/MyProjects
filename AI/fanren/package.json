{
  "name": "fanren-survivor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tools",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:inventory": "node tools/assets/inventory.mjs",
    "assets:review": "node tools/assets/review-page.mjs",
    "assets:promote": "node tools/assets/promote.mjs",
    "assets:validate": "node tools/assets/validate-manifest.mjs",
    "openspec:validate": "openspec validate --changes --no-interactive",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run assets:validate && npm run build"
  },
  "dependencies": {
    "pixi.js": "^8.6.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
