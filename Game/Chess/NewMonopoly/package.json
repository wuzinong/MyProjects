{
  "name": "three-kingdoms-monopoly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src scripts tests",
    "check": "tsc -p jsconfig.json",
    "browser": "node tests/browser.mjs",
    "quality": "node tests/quality.mjs",
    "expansion": "node tests/expansion.mjs",
    "scenery": "node tests/scenery.mjs",
    "world": "node tests/world.mjs",
    "format": "prettier --write src scripts tests *.json *.js",
    "format:check": "prettier --check src scripts tests *.json *.js"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "esbuild": "0.25.11",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
