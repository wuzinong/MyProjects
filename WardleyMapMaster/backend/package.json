{
    "name": "wardleymapmaster-backend",
    "version": "1.0.0",
    "description": "Backend service for WardleyMapMaster AI-powered analysis",
    "main": "dist/index.js",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "build": "tsc",
        "dev": "ts-node-dev --respawn src/index.ts",
        "start": "node dist/index.js"
    },
    "keywords": [
        "wardley",
        "ddd",
        "c4",
        "architecture"
    ],
    "author": "WardleyMapMaster Team",
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.5.11",
        "@types/node": "^20.10.6",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "eslint": "^8.56.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    },
    "dependencies": {
        "express": "^4.18.2",
        "zod": "^3.22.4"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": [
            "<rootDir>/src"
        ],
        "testMatch": [
            "**/__tests__/**/*.test.ts"
        ],
        "collectCoverageFrom": [
            "src/**/*.ts",
            "!src/**/*.test.ts",
            "!src/**/__tests__/**"
        ]
    }
}